    classDef consumer    fill:#146EB4,stroke:#232F3E,color:#fff

    class S3,ExtSys awsService
    class OrgLambda,WrkLambda,OrgHead,OrgPlan,OrgRecord,OrgPublish,WrkGet,WrkParse,WrkEnv,WrkBatch,WrkResult lambda
    class IntakeQ,ChunkQ,OutputQ queue
    class IntakeDLQ,ChunkDLQ dlq
    class Dynamo dynamo
    class CWLogs,CWAlarms,XRay monitor
    class Framework,Lambdas,Domain,FW,Ports,OrgSvc,WrkSvc,S3Evt,AwsPlat,Cfg,OrgCmd,WrkCmd gocode
    class TF,IaC iac
    class Consumers consumer
