%%{init: {"theme": "default", "flowchart": {"rankSpacing": 60, "nodeSpacing": 40}}}%%
flowchart TD

    %% ── Entrada ──────────────────────────────────────────────────────────────
    subgraph Entrada["Entrada"]
        S3["🪣 Amazon S3\n──────────────\nf2e-input\nVersioning · SSE · Lifecycle"]
        ExtSys["🔌 Sistema Externo\n──────────────\nOrganizerRequest\n(schemaVersion: '1')"]
    end

    %% ── Ingestão ─────────────────────────────────────────────────────────────
    subgraph Ingestao["Ingestão"]
        IntakeQ["📨 SQS: file-intake\n──────────────\nNotificação S3 ou\nOrganizerRequest explícito"]
        IntakeDLQ["☠️ SQS: file-intake-dlq\n(mensagens não processadas)"]
    end

    %% ── Lambda Organizer ─────────────────────────────────────────────────────
    subgraph OrgLambda["Lambda: organizer"]
        direction TB
        OrgHead["HEAD S3\n(Size · ETag · VersionId)"]
        OrgPlan["Planeja chunk boundaries\npor formato e configuração"]
        OrgRecord["Registra JobPlan\nno DynamoDB Ledger"]
        OrgPublish["Publica N × ChunkJob\nem chunk-jobs"]
        OrgHead --> OrgPlan --> OrgRecord --> OrgPublish
    end

    %% ── Processamento ────────────────────────────────────────────────────────
    subgraph Processamento["Processamento"]
        ChunkQ["📨 SQS: chunk-jobs\n──────────────\nN mensagens ChunkJob\n(uma por chunk)"]
        ChunkDLQ["☠️ SQS: chunk-jobs-dlq\n(chunks com falha)"]
    end

    %% ── Lambda Worker ────────────────────────────────────────────────────────
    subgraph WrkLambda["Lambda: worker  (N instâncias paralelas)"]
        direction TB
        WrkGet["Range GET S3\n(valida ETag / VersionId)"]
        WrkParse["Parseia registros\nfixed-width · jsonl · ndjson\ncsv · text · json-array · multi-line"]
        WrkEnv["Gera Envelope v2\neventId · sourceRecordId\norigem · job · chunk · payload"]
        WrkBatch["Publica lote de 10\n→ output-events"]
        WrkResult["Registra ChunkResult\nno DynamoDB Ledger"]
        WrkGet --> WrkParse --> WrkEnv --> WrkBatch --> WrkResult
    end

    %% ── Saída ────────────────────────────────────────────────────────────────
    subgraph Saida["Saída"]
        OutputQ["📨 SQS: output-events\n──────────────\nEnvelope v2 por registro\n(schema · format · eventId)"]
        Consumers["🔽 Consumidores Downstream\n──────────────\nEvent-driven · desacoplados\ndo formato físico original"]
    end

    %% ── Infraestrutura Transversal ───────────────────────────────────────────
    subgraph Infra["Infraestrutura transversal"]
        Dynamo["🗄️ DynamoDB: job-ledger\n──────────────\nPENDING → SCHEDULED\n→ RUNNING → COMPLETED/FAILED\nTTL · PITR · reconciliação/replay"]
        CWLogs["📋 CloudWatch Logs\n──────────────\nJSON estruturado\nRetention configurável"]
        CWAlarms["🔔 CloudWatch Alarms\n──────────────\nDLQ visible msgs\nBacklog age · Lambda errors"]
        XRay["🔍 AWS X-Ray\n(tracing ativo em produção)"]
    end

    %% ── Código Go ────────────────────────────────────────────────────────────
    subgraph GoCode["Módulos Go"]
        subgraph Framework["github.com/f2e/f2e  (framework)"]
            direction TB
            Domain["domain/f2e\nChunkJob · Envelope · JobLedger types"]
            FW["domain/fixedwidth\nParser largura fixa"]
            Ports["application/port\nObjectStore · Queue\nJobLedger · SourceResolver\nRecordProcessor"]
            OrgSvc["application/organizer\nService — planeja chunks"]
            WrkSvc["application/worker\nService — processa chunks"]
            S3Evt["adapter/inbound/s3event\nDecodifica notificação S3"]
            AwsPlat["platform/aws\nS3 · SQS · DynamoDB"]
            Cfg["platform/config\nVariáveis de ambiente"]
        end
        subgraph Lambdas["github.com/f2e/f2e/lambdas  (executáveis)"]
            direction LR
            OrgCmd["cmd/organizer/main.go\nBootstrap + handler Lambda"]
            WrkCmd["cmd/worker/main.go\nBootstrap + handler Lambda"]
        end
        OrgCmd --> OrgSvc
        WrkCmd --> WrkSvc
        OrgSvc --> Ports
        WrkSvc --> Ports
        Ports --> Domain
        AwsPlat --> Ports
        S3Evt --> Domain
    end

    %% ── Terraform ────────────────────────────────────────────────────────────
    subgraph IaC["Infraestrutura como Código  (Terraform)"]
        TF["s3.tf · sqs.tf · lambda.tf\ndynamodb.tf · iam.tf\nmonitoring.tf · variables.tf\n\nAmbientes: local · staging · production"]
    end

    %% ── Ligações do fluxo principal ──────────────────────────────────────────
    S3        -->|"ObjectCreated notification"| IntakeQ
    ExtSys    -->|"OrganizerRequest JSON"| IntakeQ
    IntakeQ   -.->|"redrive após N falhas"| IntakeDLQ
    IntakeQ   -->|"trigger (event source mapping)"| OrgLambda

    OrgHead   -->|"HEAD"| S3
    OrgRecord -->|"write JobPlan"| Dynamo
    OrgPublish -->|"N × ChunkJob"| ChunkQ
    OrgLambda -->|"logs JSON"| CWLogs
    OrgLambda -.->|"trace"| XRay

    ChunkQ    -.->|"redrive após N falhas"| ChunkDLQ
    ChunkQ    -->|"trigger (N paralelo)"| WrkLambda

    WrkGet    -->|"Range GET (If-Match ETag)"| S3
    WrkResult -->|"write ChunkResult"| Dynamo
    WrkBatch  -->|"OutputEvent batch"| OutputQ
    WrkLambda -->|"logs JSON"| CWLogs
    WrkLambda -.->|"trace"| XRay

    OutputQ   -->|"consume"| Consumers

    CWAlarms  -.->|"monitora"| IntakeDLQ
    CWAlarms  -.->|"monitora"| ChunkDLQ
    CWAlarms  -.->|"monitora"| IntakeQ
    CWAlarms  -.->|"monitora"| ChunkQ

    IaC       -.->|"provisiona"| Infra
    IaC       -.->|"provisiona"| Ingestao
    IaC       -.->|"provisiona"| Processamento
    IaC       -.->|"provisiona"| Saida

    %% ── Estilos ──────────────────────────────────────────────────────────────
