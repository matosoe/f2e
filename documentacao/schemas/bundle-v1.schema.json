{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f2e.local/schemas/bundle-v1.schema.json",
  "title": "F2E Bundle Envelope v1",
  "description": "SQS message body used when outputMode=bundle. Wraps multiple record envelopes from the same chunk into a single message.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "jobId", "chunkId", "items"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "f2e-bundle/1",
      "description": "Identifies this message as a bundle. Consumers must check this field before parsing."
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex digest of the sorted eventIds of all items. Stable across retries of the same logical bundle."
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "description": "Job identifier shared by all items in this bundle."
    },
    "chunkId": {
      "type": "string",
      "minLength": 1,
      "description": "Chunk identifier shared by all items in this bundle."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "Packed envelopes in publication order within the chunk. All items share the same source/processing context but carry independent eventId and sourceRecordId.",
      "items": { "$ref": "envelope-v2.schema.json" }
    }
  },
  "examples": [
    {
      "schemaVersion": "f2e-bundle/1",
      "bundleId": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
      "jobId": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
      "chunkId": "c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4",
      "items": [
        {
          "metadata": {
            "eventId": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
            "sourceRecordId": "b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3",
            "schema": { "id": "meu-sistema/evento-v1", "version": "1" },
            "format": "application/json",
            "createdAt": "2026-09-05T14:00:00Z"
          },
          "source": {
            "type": "s3",
            "bucket": "f2e-input",
            "key": "entrada/registros.txt",
            "etag": "\"d41d8cd98f00b204e9800998ecf8427e\"",
            "fileFormat": "text",
            "fileSize": 2048000
          },
          "processing": {
            "jobId": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
            "chunkId": "c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4",
            "recordNumber": 1,
