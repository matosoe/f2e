#!/usr/bin/env bash
# Entrada canônica para benchmarks: benchmark <perfil> <local|aws>.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}:${2:-}" in
  memory:local) exec "$root/benchmark-local-memory-matrix.sh" ;;
  memory:aws) exec "$root/benchmark-aws-memory-matrix.sh" ;;
  5m:local) exec "$root/benchmark-local-5m.sh" ;;
  5m:aws) exec "$root/benchmark-aws-5m.sh" ;;
  p3:aws) exec "$root/benchmark-p3-memory.sh" ;;
  matrix:aws) exec "$root/benchmark-matrix.sh" ;;
  *) echo 'Uso: automacao/benchmark <memory|5m|p3|matrix> <local|aws>' >&2; exit 2 ;;
esac
